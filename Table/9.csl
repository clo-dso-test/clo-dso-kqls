//Table//LA//
// [Cloud용 Defender에서 그룹화된 권장 사항에서 개별 권장 사항으로 전환] 반영 - 20260810
arg("").securityresources
| where type == "microsoft.security/assessments"
| where properties.resourceDetails.ResourceType =~ "microsoft.compute/virtualmachines"
| where properties.metadata.recommendationCategory == "SoftwareUpdate"
| extend VulId = tostring(properties.displayName), Severity = tostring(properties.metadata.severity), Status = tostring(properties.status.code)
| where Status == 'Unhealthy'
| summarize High = dcountif(VulId, Severity=="High"),
            Medium = dcountif(VulId, Severity=="Medium"),
            Low = dcountif(VulId, Severity=="Low")
| extend Total = High+Medium+Low
| project Total, High, Medium, Low
